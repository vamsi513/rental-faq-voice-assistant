{
  "name": "rental-voice-ws-client",
  "version": "1.0.0",
  "description": "Terminal client for the rental assistant WebSocket endpoint",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rental-chat": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
