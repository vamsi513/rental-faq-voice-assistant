# Copy to .env and fill in. Never commit .env.
# Only OPENAI_API_KEY is required to answer questions. n8n is only needed for the
# maintenance-request workflow.

# --- Required -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- Generation ---------------------------------------------------------------
# Voice is latency-bound -- the caller hears silence while the agent thinks -- so a
# small fast model beats a stronger slow one.
CHAT_MODEL=gpt-4o-mini
ROUTER_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_ANSWER_TOKENS=160

# --- Retrieval ----------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=3
HYBRID_RETRIEVAL=true
# Dense vote weight in the rank fusion. 0.9 was swept on this corpus.
DENSE_WEIGHT=0.9
# Low backstop: never blocks a real question, catches obvious garbage.
MIN_SIMILARITY=0.23
# Strong-evidence threshold that lets retrieval overrule the router.
HIGH_CONFIDENCE_SIMILARITY=0.45

# --- Conversation -------------------------------------------------------------
MAX_HISTORY_TURNS=8
SESSION_IDLE_SECONDS=1800
CHECKPOINT_DB=data/checkpoints.sqlite

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Shared access key. If set, every route except /health and /greeting requires it as
# the X-Vapi-Secret header. Set this before exposing the server through a tunnel.
SERVER_SECRET=
# Serves /debug/* and the evidence panel. Turn off for anything public.
DEBUG_PANEL=true

# --- n8n maintenance workflow -------------------------------------------------
# The PRODUCTION webhook URL from the n8n Webhook node, e.g.
#   https://your-n8n-host/webhook/maintenance
# n8n's TEST url (/webhook-test/...) only accepts one request while the editor is
# listening, so it is useless for anything but a single manual check.
N8N_WEBHOOK_URL=
# Shared credential sent as a header and checked inside the workflow. Not a user
# credential: it only proves the request came from this backend. Must match the
# PROTOTYPE_SECRET environment variable set inside n8n.
N8N_WEBHOOK_SECRET=
N8N_HEADER_NAME=X-Prototype-Secret
# A voice caller is waiting. A timeout is NOT retried -- n8n may already have the
# request, and a blind retry would duplicate the ticket.
N8N_TIMEOUT_SECONDS=8

# --- Vapi (browser demo only) -------------------------------------------------
# The PUBLIC key is designed for client code. Never put a private key here.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
